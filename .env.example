# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Publicly accessible URL where this applet is deployed.
# Used for generating scannable customer QR code links outside local development.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional server-side API key for live OpenRouter review generation.
# Leave empty to run ReviewEase AI in zero-credential mock generation mode.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Server-side model identifier used when OPENROUTER_API_KEY is configured.
OPENROUTER_MODEL="openai/gpt-4o-mini"
